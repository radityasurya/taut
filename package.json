{
  "name": "taut",
  "version": "0.1.0",
  "description": "Mobile-first PWA hub for herdr (and tmux): see every coding agent's state from your phone and reply, over Tailscale.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "taut": "server/main.ts"
  },
  "files": [
    "server",
    "shared",
    "dist/web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "make dev",
    "dev:server": "bun --watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun server/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "agentation": "^3.0.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "packageManager": "pnpm@11.25.0"
}
